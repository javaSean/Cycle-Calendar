{
  "name": "cycle-calendar",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "npm run build:mac",
    "build:mac": "node scripts/build-mac.js",
    "build:win": "electron-builder --win nsis --publish never",
    "build:icon": "node scripts/build-icon.js"
  },
  "keywords": [],
  "author": "Sean",
  "license": "ISC",
  "description": "macOS cycle tracking calendar",
  "build": {
    "appId": "com.sean.pillcalendar",
    "productName": "Cycle Calendar",
    "mac": {
      "category": "public.app-category.medical",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "files": [
      "assets/**/*",
      "main.js",
      "index.html",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  }
}
